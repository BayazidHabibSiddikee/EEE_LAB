    "provider": "custom",
    "base_url": "https://generativelanguage.googleapis.com/v1beta",
    "api_key": "YOUR_API_KEY",
    "model": "gemini-2.5-pro",
    "temperature": 0.2
  },
  "verification": {
    "enabled": true,
    "classifier_path": "models/verifier_classifier.txt",
    "feature_names_path": "models/feature_names.json",
    "threshold": 0.5
